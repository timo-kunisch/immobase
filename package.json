{
  "name": "immobase",
  "version": "1.0.0-alpha.2",
  "private": true,
  "description": "ImmoBase – Miet- + WEG-Verwaltung als offline lauffähige Desktop-App (Electron, Windows, macOS, Linux)",
  "author": "Timo Kunisch",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test": "vitest run",
    "schema:dump": "node scripts/dump-schema.mjs",
    "electron:dev": "concurrently -k \"npm:dev\" \"electron-vite dev\"",
    "electron:build": "electron-vite build",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "pack": "npm run build && npm run electron:build && electron-builder --dir",
    "dist": "npm run build && npm run electron:build && electron-builder"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "next": "16.2.11",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.19.1",
    "radix-ui": "^1.6.7",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^6.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^7.0.9",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^9.2.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0"
  }
}
